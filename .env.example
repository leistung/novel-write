# ============ PostgreSQL ============
POSTGRES_USER=storyclaw
POSTGRES_PASSWORD=storyclaw_dev_pwd
POSTGRES_DB=storyclaw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://storyclaw:storyclaw_dev_pwd@postgres:5432/storyclaw

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============ Milvus ============
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ============ Neo4j ============
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=storyclaw_neo4j_pwd

# ============ MinIO ============
MINIO_ACCESS_KEY=storyclaw
MINIO_SECRET_KEY=storyclaw_minio_pwd
MINIO_BUCKET=storyclaw

# ============ LangGraph Server ============
LANGGRAPH_URL=http://langgraph-server:8000
LANGGRAPH_DB_URI=postgresql://storyclaw:storyclaw_dev_pwd@postgres:5432/storyclaw_langgraph

# ============ Auth ============
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ============ Backend ============
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:5173

# ============ LLM defaults ============
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=8192

# ============ Embedding ============
EMBEDDING_MODEL=bge-base-zh
