# NovelWrite AI 环境配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 基础配置 ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# 生产环境必须设置强密钥（32位以上随机字符串）
# 可以使用: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-strong-secret-key-here-minimum-32-characters

# CORS配置（开发环境）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== 数据库配置 ====================
# 开发环境使用SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/novel_write.db

# 生产环境使用PostgreSQL（推荐）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/novel_write

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==================== LLM配置 ====================
# OpenAI配置（推荐）
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic配置（可选）
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# 默认LLM提供商
DEFAULT_LLM_PROVIDER=openai

# LLM调用参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# ==================== Redis配置 ====================
# 用于Celery任务队列和缓存
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ==================== Celery配置 ====================
# 如果未设置，将使用REDIS_URL作为默认值
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==================== 存储配置 ====================
STORE_PATH=./store
CHECKPOINT_PATH=./data/checkpoints

# ==================== RAG配置 ====================
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==================== MCP配置 ====================
ENABLE_MCP=false
MCP_SERVER_URL=http://localhost:3000

# ==================== 监控配置 ====================
ENABLE_METRICS=true
METRICS_PORT=9090
